    "import ast\n",
    "df = pd.read_csv(\"qdrift_ising_model_sweep_ultimate_2025-06-19.csv\")\n",
    "results = {}\n",
    "for i, row in df.iterrows():\n",
    "    n = row[\"Num Ancilla\"]\n",
    "    t = row[\"Time\"]\n",
    "    print(f\"({n}, {t})\")\n",
    "    results[(n, t)] = ast.literal_eval(row[\"Raw results\"])\n",
    "\n",
    "len(results)\n"
   ]
